<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your SkillShelf Verification Code</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f5f7;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0">
      Your SkillShelf verification code is <%= otp %>. Valid for 2 minutes.
    </div>

    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f5f7; padding: 35px 15px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 520px;
              background-color: #ffffff;
              border-radius: 16px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 30px 25px 25px; background-color: #111827"
              >
                <h1
                  style="
                    margin: 0;
                    font-size: 30px;
                    font-weight: 800;
                    letter-spacing: -1px;
                  "
                >
                  <span
                    style="
                      background: linear-gradient(to right, #4f8ef7, #7b3fe4);
                      -webkit-background-clip: text;
                      background-clip: text;
                      color: transparent;
                    "
                  >
                    Skill </span
                  ><span
                    style="
                      background: linear-gradient(to right, #ff8c00, #f5c518);
                      -webkit-background-clip: text;
                      background-clip: text;
                      color: transparent;
                    "
                  >
                    Shelf
                  </span>
                </h1>

                <p style="margin: 12px 0 0; color: #d1d5db; font-size: 14px">
                  Your Learning Journey Starts Here
                </p>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td align="center" style="padding: 40px 30px 20px">
                <div
                  style="
                    width: 65px;
                    height: 65px;
                    line-height: 65px;
                    border-radius: 50%;
                    background-color: #fff5d6;
                    color: #e58b00;
                    font-size: 30px;
                    margin-bottom: 20px;
                  "
                >
                  &#128273;
                </div>

                <h2 style="margin: 0 0 15px; color: #1f2937; font-size: 25px">
                  Verify Your Email
                </h2>

                <p
                  style="
                    margin: 0;
                    color: #6b7280;
                    font-size: 15px;
                    line-height: 25px;
                  "
                >
                  Hello <strong style="color: #111827"><%= name %></strong>,
                  <br />
                  We're happy to have you with us! Please use the verification
                  code below to complete your verification.
                </p>
              </td>
            </tr>

            <!-- OTP Box -->
            <tr>
              <td align="center" style="padding: 15px 30px 25px">
                <p
                  style="
                    margin: 0 0 15px;
                    color: #6b7280;
                    font-size: 13px;
                    font-weight: bold;
                    letter-spacing: 1px;
                  "
                >
                  YOUR VERIFICATION CODE
                </p>

                <div
                  style="
                    display: inline-block;
                    padding: 18px 35px;
                    background-color: #fff8e5;
                    border: 2px dashed #f5c518;
                    border-radius: 12px;
                  "
                >
                  <span
                    style="
                      font-size: 36px;
                      font-weight: 800;
                      letter-spacing: 10px;
                      color: #d97706;
                    "
                  >
                    <%= otp %>
                  </span>
                </div>
              </td>
            </tr>

            <!-- Expiry Notice -->
            <tr>
              <td align="center" style="padding: 0 30px 30px">
                <table
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #fff7ed;
                    border-radius: 8px;
                    width: 100%;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 14px 12px">
                      <p
                        style="
                          margin: 0;
                          color: #c2410c;
                          font-size: 14px;
                          font-weight: bold;
                        "
                      >
                        &#9200; Expires in 2 Minutes
                      </p>

                      <p
                        style="margin: 6px 0 0; color: #9a3412; font-size: 12px"
                      >
                        Please complete your verification before the code
                        expires.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Security Notice -->
            <tr>
              <td style="padding: 0 30px 35px">
                <p
                  style="
                    margin: 0;
                    color: #6b7280;
                    font-size: 13px;
                    line-height: 22px;
                    text-align: center;
                  "
                >
                  If you didn't request this verification code, you can safely
                  ignore this email. Never share your OTP with anyone.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 22px 20px;
                  background-color: #f9fafb;
                  border-top: 1px solid #eeeeee;
                "
              >
                <p style="margin: 0 0 8px; color: #6b7280; font-size: 13px">
                  Thank you for choosing
                  <strong style="color: #d97706">SkillShelf</strong>.
                </p>

                <p style="margin: 0; color: #9ca3af; font-size: 11px">
                  &copy; 2026 SkillShelf. All rights reserved.
                </p>

                <p style="margin: 8px 0 0; color: #9ca3af; font-size: 11px">
                  Learn More. Grow More.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
